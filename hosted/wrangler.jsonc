{
  "name": "whitebook-ticket-03-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "vars": {
    "AI_RELEASE_ENABLED": "false",
    "APP_ORIGIN": "https://whitebook-ticket-03-staging.anothermiralph.workers.dev"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whitebook-ticket-03-staging",
      "database_id": "8d8415ec-fc45-4648-8369-598f0c8fa4f1",
      "migrations_dir": "migrations"
    }
  ]
}
